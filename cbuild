#!/usr/bin/env bash

source "./lib/logger.sh"
source "./lib/builder.sh"
source "./lib/config.sh"

verificar_gcc() {
    if ! command -v gcc &> /dev/null; then
        log_error "O GCC nao foi encontrado."
        exit 1
    fi
}

validar_comando() {
    local comando="$1"

    if [[ -z "$comando" ]]; then
        log_error "Nenhum comando digitado { build / run / clean / rebuild / info}"
        exit 1
    fi

    case "$comando" in
        build|run|clean|rebuild|info)
            # comando valido, nao faz nada
            ;;
        *)
            log_error "Invalido: '$comando'. Opcoes: { build / run / clean / rebuild / info}"
            exit 1
            ;;
    esac
}

verificar_permissao() {
    if [[ ! -r "." || ! -w "." || ! -x "." ]]; then
        log_error "Permissoes insuficientes no diretorio do projeto."
        exit 1
    fi
}

verificar_permissao
log_info "Estrutura inicial rodando (cbuild)"

carregar_configuracao
verificar_gcc
verificar_arquivos_c "$DIRETORIO_FONTE" #src

log_info "Configuracao valida. Nome executavel: $NOME_EXECUTAVEL"

COMANDO="$1"
validar_comando "$COMANDO"
log_info "Comando '$COMANDO' existe"
